# ===== 目标平台（生成器只通过 HTTP 访问，不共享任何基础设施） =====
# 本地演示实例；建议指向独立的 mydatama 测试实例（如 8091）避免污染开发库
BASE_URL=http://localhost:8090
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123

# ===== TTS（edge-tts，需联网；失败时自动等长静音兜底） =====
TTS_VOICE=zh-CN-YunxiNeural
TTS_RATE=-5%
FALLBACK_RATE_CPM=220

# ===== 视频规格 =====
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080
VIDEO_FPS=30
TAIL_SECONDS=0.8
FINAL_NAME=mydatama-v0.1-讲解视频-1080p.mp4
HEADLESS=true

# ===== 处理轮询 =====
LIVE_TIMEOUT=300
POLL_INTERVAL=3

# ===== 反面演示造数（默认关闭；仅限一次性演示库，切勿指向生产）=====
# 平台在 configure 阶段硬性拦阻密级倒挂，纯 HTTP 无法进入合规页复现 R1 红屏；
# 配置后生成器会在反面产品生成后直连演示库将其密级改为 1 再跑合规。
# Docker 运行且与 mydatama 同一 Docker 网络时示例：
# DEMO_TWEAK_DSN=host=postgres port=5432 dbname=mydatama user=mydatama password=change_me_in_prod
# DEMO_TWEAK_DSN=
